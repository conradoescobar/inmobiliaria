# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/inmobiliaria
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/inmobiliaria

# Application Settings
APP_NAME=Inmobiliaria Aggregator
DEBUG=true
SECRET_KEY=your-secret-key-here

# Scraper Settings
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_DELAY_SECONDS=2
SCRAPER_MAX_RETRIES=3

# Deduplication Settings
DEDUP_ADDRESS_THRESHOLD=0.85
DEDUP_FEATURES_THRESHOLD=0.90
